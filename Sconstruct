#!/usr/bin/env python3

from SCons.Script import Environment, Glob, ARGUMENTS, Command, Default, Exit
import os

PROJECT_NAME = "godot_apng"

GODOT_CPP = "godot-cpp"
SOURCE_DIR = "src"

OUTPUT_DIR = "addons/GodotAnimatedPNGParser"
GDEXTENSION_FILE = os.path.join(
    OUTPUT_DIR,
    "GodotAPNGParser.gdextension"
)

ENTRY_SYMBOL = "godot_apng_library_init"

platform = ARGUMENTS.get("platform", "linux")
arch = ARGUMENTS.get("arch", "x86_64")

if platform not in ["linux", "windows"]:
    print("Unsupported platform: " + platform)
    print("Use:")
    print("    scons platform=linux")
    print("    scons platform=windows")
    Exit(1)

# 
# Environment
# 

env = Environment()

env.Append(CPPPATH=[
    GODOT_CPP + "/include",
    GODOT_CPP + "/gen/include",
    GODOT_CPP + "/gdextension"
])

sources = Glob(
    SOURCE_DIR + "/*.cpp"
)

# 
# Find godot-cpp static library
# 

godot_cpp_bin = GODOT_CPP + "/bin"
godot_cpp_lib = None

if not os.path.isdir(godot_cpp_bin):
    print("ERROR: Missing godot-cpp/bin")
    Exit(1)

for filename in os.listdir(godot_cpp_bin):

    if not filename.endswith(".a"):
        continue

    name = filename.lower()

    if platform.lower() not in name:
        continue

    if arch.lower() not in name:
        continue

    godot_cpp_lib = os.path.join(
        godot_cpp_bin,
        filename
    )

    break

if godot_cpp_lib is None:
    print(
        "ERROR: Could not find godot-cpp library for "
        + platform + " " + arch
    )
    Exit(1)

print("Using godot-cpp: " + godot_cpp_lib)

# 
# Link godot-cpp
# 

env.Append(
    LINKFLAGS=[
        "-Wl,--whole-archive",
        godot_cpp_lib,
        "-Wl,--no-whole-archive"
    ]
)

# 
# Output
# 

if platform == "linux":

    target = os.path.join(
        OUTPUT_DIR,
        "GodotAPNGParser.linux.x86_64.so"
    )

elif platform == "windows":

    target = os.path.join(
        OUTPUT_DIR,
        "GodotAPNGParser.windows.x86_64.dll"
    )

# 
# Build extension
# 

library = env.SharedLibrary(
    target=target,
    source=sources
)

# 
# Generate .gdextension
# 

gdextension_contents = """[configuration]

entry_symbol = "%s"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://%s/libGodotAPNGParser.linux.x86_64.so"
linux.release.x86_64 = "res://%s/libGodotAPNGParser.linux.x86_64.so"

windows.debug.x86_64 = "res://%s/libGodotAPNGParser.windows.x86_64.dll"
windows.release.x86_64 = "res://%s/libGodotAPNGParser.windows.x86_64.dll"
""" % (
    ENTRY_SYMBOL,
    OUTPUT_DIR,
    OUTPUT_DIR,
    OUTPUT_DIR,
    OUTPUT_DIR
)

def generate_gdextension(target, source, env):
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    with open(GDEXTENSION_FILE, "w") as f:
        f.write(gdextension_contents)

    print("Generated: " + GDEXTENSION_FILE)

gdextension = Command(
    GDEXTENSION_FILE,
    [],
    generate_gdextension
)

Default([library, gdextension])