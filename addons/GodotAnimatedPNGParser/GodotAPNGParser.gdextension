[configuration]

entry_symbol = "godot_apng_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/GodotAnimatedPNGParser/libGodotAPNGParser.linux.x86_64.so"
linux.release.x86_64 = "res://addons/GodotAnimatedPNGParser/libGodotAPNGParser.linux.x86_64.so"

windows.debug.x86_64 = "res://addons/GodotAnimatedPNGParser/libGodotAPNGParser.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/GodotAnimatedPNGParser/libGodotAPNGParser.windows.x86_64.dll"
